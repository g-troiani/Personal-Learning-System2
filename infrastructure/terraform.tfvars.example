# Copy this file to terraform.tfvars and fill in your values
# DO NOT commit terraform.tfvars to git

# AWS region to deploy to
aws_region = "us-east-1"

# Name for the SSH key pair (will be created)
key_name = "learning-system-key"

# IMPORTANT: Set this to your IP for SSH access security
# Find your IP at https://ifconfig.me
# Format: "x.x.x.x/32" for single IP
allowed_ssh_cidr = "0.0.0.0/0"  # CHANGE THIS!

# EC2 instance type (t3.micro is free tier eligible)
instance_type = "t3.micro"
